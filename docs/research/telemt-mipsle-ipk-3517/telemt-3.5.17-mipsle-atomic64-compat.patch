diff --git a/src/compat.rs b/src/compat.rs
new file mode 100644
index 0000000..f620ba6
--- /dev/null
+++ b/src/compat.rs
@@ -0,0 +1,135 @@
+//! Architecture compatibility layer for 64-bit atomics.
+//!
+//! Targets with native 64-bit atomics (x86_64, aarch64, ...) keep the standard
+//! `std::sync::atomic::AtomicU64` so the hot path stays unchanged and zero-cost.
+//! MIPS32r2 (Entware `mipsel-3.4`, MT7621) lacks `target_has_atomic = "64"`, so
+//! the standard library does not provide `AtomicU64` at all; there this module
+//! re-exports `portable_atomic::AtomicU64`, which implements the identical API
+//! with a global-lock fallback on 32-bit atomics.
+//!
+//! This is a type re-export only: ordering semantics, CAS loops, counters,
+//! traffic limits, quotas and replay accounting are untouched, and no `AtomicU64`
+//! is downgraded to a narrower type. The lock fallback trades throughput, not
+//! correctness; runtime behavior on the device remains gated by QEMU validation.
+
+#[cfg(target_has_atomic = "64")]
+pub use std::sync::atomic::AtomicU64;
+
+#[cfg(not(target_has_atomic = "64"))]
+pub use portable_atomic::AtomicU64;
+
+#[cfg(test)]
+mod tests {
+    use std::sync::atomic::Ordering;
+    use std::sync::Arc;
+
+    use super::AtomicU64;
+
+    /// The selected atomic type must expose the full API surface upstream uses,
+    /// with the same semantics, on both the native and the fallback path.
+    #[test]
+    fn api_parity_basic_operations() {
+        let value = AtomicU64::new(7);
+        assert_eq!(value.load(Ordering::Relaxed), 7);
+        value.store(9, Ordering::Release);
+        assert_eq!(value.load(Ordering::Acquire), 9);
+        assert_eq!(value.swap(3, Ordering::AcqRel), 9);
+        assert_eq!(value.fetch_add(4, Ordering::Relaxed), 3);
+        assert_eq!(value.fetch_sub(1, Ordering::Relaxed), 7);
+        assert_eq!(value.fetch_or(8, Ordering::Relaxed), 6);
+        assert_eq!(value.fetch_and(0xFF, Ordering::Relaxed), 14);
+        assert_eq!(value.fetch_max(100, Ordering::Relaxed), 14);
+        assert_eq!(value.into_inner(), 100);
+        let mut owned = AtomicU64::new(5);
+        assert_eq!(owned.get_mut(), &mut 5);
+        *owned.get_mut() = 41;
+        assert_eq!(owned.load(Ordering::SeqCst), 41);
+    }
+
+    /// CAS admission loops (slot budgets, rate limiter windows, quota charge,
+    /// replay windows) must still progress through the compatibility alias.
+    #[test]
+    fn compare_exchange_cas_loop_progresses() {
+        let slot = AtomicU64::new(0);
+        let mut observed = Vec::new();
+        loop {
+            let current = slot.load(Ordering::Relaxed);
+            if current >= 10 {
+                break;
+            }
+            match slot.compare_exchange(
+                current,
+                current + 1,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => observed.push(current),
+                Err(actual) => observed.push(actual),
+            }
+        }
+        assert_eq!(slot.load(Ordering::Relaxed), 10);
+        assert_eq!(observed.len(), 10);
+        assert!(observed.windows(2).all(|pair| pair[0] <= pair[1]));
+    }
+
+    /// Monotonic accounting counters shared across threads must not lose
+    /// increments under concurrent access.
+    #[test]
+    fn concurrent_fetch_add_matches_expected_total() {
+        const THREADS: u64 = 8;
+        const INCREMENTS: u64 = 10_000;
+        let counter = Arc::new(AtomicU64::new(0));
+        let handles: Vec<_> = (0..THREADS)
+            .map(|_| {
+                let counter = Arc::clone(&counter);
+                std::thread::spawn(move || {
+                    for _ in 0..INCREMENTS {
+                        counter.fetch_add(1, Ordering::Relaxed);
+                    }
+                })
+            })
+            .collect();
+        for handle in handles {
+            handle.join().expect("counter thread must not panic");
+        }
+        assert_eq!(counter.load(Ordering::Relaxed), THREADS * INCREMENTS);
+    }
+
+    /// Concurrent CAS contention on a single slot must make exactly the
+    /// expected number of successful transitions (traffic limiter refill).
+    #[test]
+    fn concurrent_compare_exchange_is_lossless() {
+        const THREADS: usize = 4;
+        const CLAIMS: u64 = 1_000;
+        let slot = Arc::new(AtomicU64::new(0));
+        let handles: Vec<_> = (0..THREADS)
+            .map(|_| {
+                let slot = Arc::clone(&slot);
+                std::thread::spawn(move || {
+                    let mut claims = 0;
+                    while claims < CLAIMS {
+                        let current = slot.load(Ordering::Relaxed);
+                        if slot
+                            .compare_exchange(
+                                current,
+                                current + 1,
+                                Ordering::AcqRel,
+                                Ordering::Relaxed,
+                            )
+                            .is_ok()
+                        {
+                            claims += 1;
+                        }
+                    }
+                    claims
+                })
+            })
+            .collect();
+        let total: u64 = handles
+            .into_iter()
+            .map(|handle| handle.join().expect("CAS thread must not panic"))
+            .sum();
+        assert_eq!(total, THREADS as u64 * CLAIMS);
+        assert_eq!(slot.load(Ordering::Relaxed), THREADS as u64 * CLAIMS);
+    }
+}
