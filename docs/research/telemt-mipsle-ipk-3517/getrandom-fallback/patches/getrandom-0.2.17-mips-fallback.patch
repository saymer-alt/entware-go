+//! Implementation for Linux / MIPS (o32) with `/dev/urandom` fallback.
+//!
+//! Research-only Entware/MIPS32r2 softfloat fork of upstream
+//! `linux_android_with_fallback.rs` (getrandom, MIT OR Apache-2.0), selected
+//! ONLY for `all(target_os = "linux", target_arch = "mips", target_env = "gnu")`
+//! by `lib.rs`. Platform fact (proven 2026-11-16 on KeeneticOS Ported
+//! 5.1.8 MT7621, kernel 4.9-ndm-5): getrandom(2) returns ENOSYS while the
+//! /dev/urandom driver itself works. Deltas from upstream:
+//!   1. fallback on ENOSYS only (upstream additionally falls back on EPERM for
+//!      seccomp-blocked getrandom; deliberately not adopted here so any other
+//!      failure surfaces as a hard error),
+//!   2. this module is routed only for Linux/MIPS/gnu; no other platform's
+//!      backend selection is changed.
+//! The readiness barrier, EINTR/partial handling and fail-closed semantics are
+//! upstream's own code, unchanged.
+use crate::{
+    lazy::LazyBool,
+    util_libc::{getrandom_syscall, last_os_error, sys_fill_exact},
+    {use_file, Error},
+};
+use core::mem::MaybeUninit;
+
+pub fn getrandom_inner(dest: &mut [MaybeUninit<u8>]) -> Result<(), Error> {
+    // Research-only test hook (upstream 0.4.x parity): force the fallback
+    // path regardless of getrandom(2) availability.
+    #[cfg(getrandom_test_linux_fallback)]
+    {
+        return use_file::getrandom_inner(dest);
+    }
+    // getrandom(2) was introduced in Linux 3.17
+    static HAS_GETRANDOM: LazyBool = LazyBool::new();
+    if HAS_GETRANDOM.unsync_init(is_getrandom_available) {
+        sys_fill_exact(dest, getrandom_syscall)
+    } else {
+        #[cfg(getrandom_test_linux_without_fallback)]
+        panic!("Fallback is triggered with enabled `getrandom_test_linux_without_fallback`");
+        use_file::getrandom_inner(dest)
+    }
+}
+
+fn is_getrandom_available() -> bool {
+    if getrandom_syscall(&mut []) < 0 {
+        match last_os_error().raw_os_error() {
+            Some(libc::ENOSYS) => false, // No kernel support
+            // ENOSYS-only per the research assignment: any other error keeps the
+            // getrandom path so the real call surfaces the failure (fail closed).
+            _ => true,
+        }
+    } else {
+        true
+    }
+}
+
+#[cfg(test)]
+mod mips_fallback_tests {
+    use super::getrandom_inner;
+
+    /// Entropy source must yield distinct consecutive buffers both on the
+    /// getrandom(2) path and (with `--cfg getrandom_test_linux_fallback`)
+    /// on the /dev/urandom fallback path with its readiness barrier.
+    #[test]
+    fn entropy_source_returns_distinct_buffers() {
+        let mut a = [0u8; 32];
+        let mut b = [0u8; 32];
+        getrandom_inner(&mut a).expect("entropy source failed");
+        getrandom_inner(&mut b).expect("entropy source failed");
+        assert_ne!(a, b, "entropy source produced identical consecutive buffers");
+    }
+}
