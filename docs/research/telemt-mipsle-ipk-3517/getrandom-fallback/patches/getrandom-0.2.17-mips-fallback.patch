@@ -0,0 +1,26 @@
+//! Research-only integration probes for the MIPS /dev/urandom fallback fork.
+//! The `getrandom_test_linux_fallback` cfg (upstream's own test hook) forces
+//! the fallback path regardless of getrandom(2) availability.
+
+#[test]
+fn entropy_fill_returns_distinct_bytes() {
+    let mut a = [0u8; 32];
+    let mut b = [0u8; 32];
+    getrandom::getrandom(&mut a).expect("entropy source failed");
+    getrandom::getrandom(&mut b).expect("entropy source failed");
+    assert_ne!(a, b, "entropy source produced identical consecutive buffers");
+}
+
+/// Exercised inside a mount namespace whose /dev is an empty tmpfs:
+/// the crate must fail closed (return an error), never fabricate success.
+#[test]
+fn missing_entropy_device_fails_closed() {
+    if std::path::Path::new("/dev/urandom").exists() {
+        return; // skip outside the fail-closed namespace
+    }
+    let mut a = [0u8; 32];
+    assert!(
+        getrandom::getrandom(&mut a).is_err(),
+        "entropy fill must NOT succeed without an entropy device"
+    );
+}
